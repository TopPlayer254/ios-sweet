 for(unsigned i=2;i<6;i++){if(!g24n_raw(0x3da0800+4*i,&smr)||!g24n_raw(0x3da0c00+4*i,&s2cr))return 0;if(i==2){if(!g33_slot_permitted(smr,s2cr))return 0;}else if(smr||s2cr!=0x20000)return 0;}
