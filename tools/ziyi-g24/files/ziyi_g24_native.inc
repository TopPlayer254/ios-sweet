  if(!h->page[i].pa||(h->page[i].pa&16383)||h->page[i].pa>=(1ULL<<36)||h->page[i].pa==g24n.s->hfi_memory.page[0].pa)return 0;
  for(unsigned j=0;j<i;j++)if(h->page[j].pa==h->page[i].pa)return 0;
