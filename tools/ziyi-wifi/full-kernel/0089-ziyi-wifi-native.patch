+ !wr(q,io,0x2c,ZWN_UP)||!kick(q,io)||!wait(q,io,0x14,ZWN_UP)||!wr(q,io,0x18,ZWN_UP)||!kick(q,io)||!wait(q,io,0x30,ZWN_UP))return 0;
