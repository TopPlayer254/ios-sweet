+ for(size_t i=0;i<sizeof(*a);i++){
+  if((i>=sm&&i<sm+4)||(i>=sc&&i<sc+4))continue;
+  if(av[i]!=cv[i]||bv[i]!=cv[i])return 0;
+ }
+ return 1;
+}
