+/* ---- time, threads, sleeping --------------------------------------------------------------------------- */
+
+unsigned long long
+lx_os_nanoseconds(void)
+{
+	uint64_t nanoseconds;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &nanoseconds);
+	return nanoseconds;
