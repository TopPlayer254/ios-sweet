+
+/* ---- handles ----------------------------------------------------------------------------------- */
+
+/* What stands behind a handle (its `sock` points here). */
+struct qmi_state {
+	struct qmi_handle *handle;
+	const struct hakios_qrtr_ops *transport;
+	struct hakios_qrtr_port *port;
+	struct os_lock lock;                    /* the lists below and the transactions in them */
+	struct qmi_ops ops;
+	const struct qmi_msg_handler *handlers;
+	size_t largest;
+	struct qmi_txn *transactions;
+	uint16_t last_id;
+	struct qmi_service *services;
+	bool connected;
+	uint32_t peer_node, peer_port;
+	/* said in the log once each, so that a firmware that talks a lot cannot fill it */
+	bool said_malformed, said_undecoded, said_unknown;
+	/* Exact discovered WLFW endpoint, published before its new_server callback. */
+	uint32_t ziyi_wlfw_node, ziyi_wlfw_port;
+};
+
+static const struct hakios_qrtr_ops *qmi_transport;
+
+void
+hakios_qmi_set_transport(const struct hakios_qrtr_ops *ops)
+{
+	qmi_transport = ops;
+}
+
+static struct qmi_state *
+state_of(struct qmi_handle *qmi)
+{
+	return qmi != NULL ? (struct qmi_state *)(void *)qmi->sock : NULL;
+}
+
+/* With the lock held. */
+static struct qmi_txn **
+find_transaction(struct qmi_state *s, const struct qmi_txn *txn, uint16_t id)
+{
+	struct qmi_txn **p;
+
+	for (p = &s->transactions; *p != NULL; p = &(*p)->next) {
+		if (txn != NULL ? *p == txn : (*p)->id == id) {
+			return p;
+		}
+	}
+	return NULL;
+}
+
+/* A message that is not the reply somebody waits for: to its handler, if it has one. */
+static void
+to_handler(struct qmi_state *s, uint8_t type, uint16_t id, uint16_t message, uint32_t node, uint32_t port, const void *data,
+    size_t length)
+{
+	const struct qmi_msg_handler *h;
+	struct sockaddr_qrtr from = { .sq_family = AF_QIPCRTR, .sq_node = node, .sq_port = port };
+	struct qmi_txn txn = { .qmi = s->handle, .id = id };
+	void *decoded;
+	int result;
+
+	for (h = s->handlers; h != NULL && h->fn != NULL; h++) {
+		if (h->type == type && h->msg_id == message) {
+			break;
+		}
+	}
+	if (h == NULL || h->fn == NULL) {
+		if (!s->said_unknown) {
+			s->said_unknown = true;
+			os_log("qmi: a message nobody handles: type %u, id %#x, %zu bytes (said once)\n", type, message, length);
+		}
+		return;
+	}
+	decoded = os_alloc(h->decoded_size);
+	if (decoded == NULL) {
+		return;
+	}
+	result = hakios_qmi_decode(data, length, h->ei, decoded);
+	if (result < 0) {
+		if (!s->said_undecoded) {
+			s->said_undecoded = true;
+			os_log("qmi: message %#x (type %u, %zu bytes) cannot be decoded: %d (said once)\n", message, type, length, result);
+		}
+	} else {
+		h->fn(s->handle, &from, &txn, decoded);
+	}
+	os_free(decoded, h->decoded_size);
+}
+
+/* The router has a datagram for us. */
+static void
+qmi_receive(void *context, uint32_t node, uint32_t port, const void *data, size_t length)
+{
+	struct qmi_state *s = context;
+	const uint8_t *header = data;
+	struct qmi_txn **found, *txn;
+	uint16_t id, message;
+	uint8_t type;
+
+	if (length < QMI_HEADER_SIZE || length > s->largest + QMI_HEADER_SIZE ||
+	    (size_t)(header[5] | header[6] << 8) > length - QMI_HEADER_SIZE) {
+		if (!s->said_malformed) {
+			s->said_malformed = true;
+			os_log("qmi: a datagram of %zu bytes from %u:%u is no message we take (said once)\n", length, node, port);
+		}
+		return;
+	}
+	type = header[0];
+	id = (uint16_t)(header[1] | header[2] << 8);
+	message = (uint16_t)(header[3] | header[4] << 8);
+	if (type == QMI_RESPONSE) {
+		os_lock(&s->lock);
+		found = find_transaction(s, NULL, id);
+		txn = found != NULL ? *found : NULL;
+		if (txn != NULL && !txn->done && txn->ei != NULL && txn->dest != NULL) {
+			txn->result = hakios_qmi_decode(data, length, txn->ei, txn->dest);
+			txn->done = true;
+			os_wake(&s->lock, txn);
+			os_unlock(&s->lock);
+			return;
+		}
+		os_unlock(&s->lock);
+		if (txn == NULL) {
+			return;                         /* a reply to nothing: late, after its transaction was given up */
+		}
+	}
+	to_handler(s, type, id, message, node, port, data, length);
+}
+
+/* The router says a server we asked about is there, or is gone. */
+static void
+qmi_server(void *context, bool arrived, uint32_t service, uint32_t version, uint32_t instance, uint32_t node, uint32_t port)
+{
+	struct qmi_state *s = context;
+	struct qmi_service *svc, **p;
+
+	os_lock(&s->lock);
+	for (p = &s->services; *p != NULL; p = &(*p)->next) {
+		if ((*p)->node == node && (*p)->port == port) {
+			break;
+		}
+	}
+	svc = *p;
+#ifdef KERNEL
+	if ((!arrived && s->ziyi_wlfw_node==node && s->ziyi_wlfw_port==port) ||
+	    (arrived && service==0x45 && version==1 && instance==3 && node==13 && port)) {
+		s->ziyi_wlfw_node=arrived?node:0;s->ziyi_wlfw_port=arrived?port:0;
+	}
+#endif
+	if (!arrived && svc != NULL) {
+		*p = svc->next;
+	}
+	os_unlock(&s->lock);
+
+	if (arrived && svc == NULL) {
+		svc = os_alloc(sizeof(*svc));
+		if (svc == NULL) {
+			return;
+		}
+		svc->service = service;
+		svc->version = version;
+		svc->instance = instance;
+		svc->node = node;
+		svc->port = port;
+		if (s->ops.new_server != NULL && s->ops.new_server(s->handle, svc) < 0) {
+			os_lock(&s->lock);
+			if(s->ziyi_wlfw_node==node&&s->ziyi_wlfw_port==port){s->ziyi_wlfw_node=0;s->ziyi_wlfw_port=0;}
+			os_unlock(&s->lock);
+			os_free(svc, sizeof(*svc));
+			return;
+		}
+		os_lock(&s->lock);
+		svc->next = s->services;
+		s->services = svc;
+		os_unlock(&s->lock);
+	} else if (!arrived && svc != NULL) {
+		if (s->ops.del_server != NULL) {
+			s->ops.del_server(s->handle, svc);
+		}
+		os_free(svc, sizeof(*svc));
+	}
+}
+
+int
+hakios_qmi_handle_init_transport(struct qmi_handle *qmi, size_t largest, const struct qmi_ops *ops,
+    const struct qmi_msg_handler *handlers, const struct hakios_qrtr_ops *transport)
+{
+	struct qmi_state *s;
+
+	qmi->sock = NULL;
+	if (transport == NULL) {
+		return -ENXIO;
+	}
+	s = os_alloc(sizeof(*s));
+	if (s == NULL) {
+		return -ENOMEM;
+	}
+	s->handle = qmi;
+	s->transport = transport;
+	s->largest = largest;
+	s->handlers = handlers;
+	if (ops != NULL) {
+		s->ops = *ops;
+	}
+	os_lock_init(&s->lock);
+	qmi->sock = (struct socket *)(void *)s;         /* before the port: callbacks may come at once */
+	s->port = transport->open(qmi_receive, qmi_server, s);
+	if (s->port == NULL) {
+		qmi->sock = NULL;
+		os_lock_destroy(&s->lock);
+		os_free(s, sizeof(*s));
+		return -ENXIO;
+	}
+	return 0;
+}
+
+int
+qmi_handle_init(struct qmi_handle *qmi, size_t largest, const struct qmi_ops *ops, const struct qmi_msg_handler *handlers)
+{
+	return hakios_qmi_handle_init_transport(qmi, largest, ops, handlers, qmi_transport);
+}
+
+/* Nobody may be waiting in qmi_txn_wait() on this handle any more. */
+void
+qmi_handle_release(struct qmi_handle *qmi)
+{
+	struct qmi_state *s = state_of(qmi);
+	struct qmi_service *svc;
+
+	if (s == NULL) {
+		return;
+	}
+	s->transport->close(s->port);                   /* no callback after this */
+	while ((svc = s->services) != NULL) {
+		s->services = svc->next;
+		os_free(svc, sizeof(*svc));
+	}
+	qmi->sock = NULL;
+	os_lock_destroy(&s->lock);
+	os_free(s, sizeof(*s));
+}
+
+int
+qmi_add_lookup(struct qmi_handle *qmi, unsigned int service, unsigned int version, unsigned int instance)
+{
+	struct qmi_state *s = state_of(qmi);
+	int error;
+
+	if (s == NULL) {
+		return -EINVAL;
+	}
+	error = s->transport->lookup(s->port, service, version, instance);
+	return error > 0 ? -error : error;
+}
+
+int
+hakios_qmi_connect(struct socket *sock, uint32_t node, uint32_t port)
+{
+	struct qmi_state *s = (struct qmi_state *)(void *)sock;
+
+	if (s == NULL) {
+		return -EINVAL;
+	}
+	os_lock(&s->lock);
+	s->peer_node = node;
+	s->peer_port = port;
+	s->connected = true;
+	os_unlock(&s->lock);
+	return 0;
+}
+
+int
+qmi_txn_init(struct qmi_handle *qmi, struct qmi_txn *txn, const struct qmi_elem_info *ei, void *structure)
+{
+	struct qmi_state *s = state_of(qmi);
+	uint16_t id;
+
+	memset(txn, 0, sizeof(*txn));
+	if (s == NULL) {
+		return -EINVAL;
+	}
+	txn->qmi = qmi;
+	txn->ei = ei;
+	txn->dest = structure;
+	os_lock(&s->lock);
+	/* the next number nobody else has (0 to 65534, round and round) */
+	for (id = (uint16_t)(s->last_id + 1);; id++) {
+		if (id == 0xffff) {
+			id = 0;
+		}
+		if (find_transaction(s, NULL, id) == NULL) {
+			break;
+		}
+		if (id == s->last_id) {
+			os_unlock(&s->lock);
+			return -ENOMEM;                 /* 65535 of them at once */
+		}
+	}
+	s->last_id = id;
+	txn->id = id;
+	txn->next = s->transactions;
+	s->transactions = txn;
+	os_unlock(&s->lock);
+	return id;
+}
+
+#ifdef KERNEL
+extern int ziyi_wifi_native_binding(int);
+/* Xiaomi 24856283 ICNSS2 QMI HOST_CAP GPIO_INFO, not APSS GPIO MMIO.
+ * cnss_utils/wlan_firmware_service_v01.c: TLV0x2d, u8 count + u32 array.
+ * icnss2/qmi.c: indices WLAN_EN/BT_EN/HOST_SOL/TARGET_SOL; absent=0xffff.
+ * The caller binds the discovered WLFW service and native ziyi boot epoch.
+ * Validate the whole original packet before writing any byte. */
+static __attribute__((noinline)) int
+ziyi_wlfw_host_cap(uint8_t *packet, size_t length, size_t capacity,
+    unsigned wlan_en, int bound)
+{
+ if(!bound || wlan_en!=25u)return -EPERM;
+ if(!packet || length<7 || length>capacity || length>65542u)return -EINVAL;
+ if(packet[0]!=0 || packet[3]!=0x34 || packet[4]!=0 ||
+    (size_t)(packet[5]|packet[6]<<8)!=length-7)return -EINVAL;
+ for(size_t at=7;at<length;){
+  if(length-at<3)return -EINVAL;
+  size_t bytes=(size_t)(packet[at+1]|packet[at+2]<<8);
+  if(bytes>length-at-3 || packet[at]==0x2d)return -EINVAL;
+  at+=3+bytes;
+ }
+ if(capacity-length<20 || length-7>65535u-20u)return -ENOSPC;
+ uint8_t *p=packet+length;
+ p[0]=0x2d;p[1]=17;p[2]=0;p[3]=4;
+ const uint32_t gpio[4]={25u,0xffffu,0xffffu,0xffffu};
+ for(unsigned i=0;i<4;i++)for(unsigned b=0;b<4;b++)
+  p[4+4*i+b]=(uint8_t)(gpio[i]>>(8*b));
+ size_t payload=length-7+20;
+ packet[5]=(uint8_t)payload;packet[6]=(uint8_t)(payload>>8);
+ return (int)(length+20);
+}
+#endif
+
+int
+qmi_send_request(struct qmi_handle *qmi, struct sockaddr_qrtr *sq, struct qmi_txn *txn, int msg_id, size_t largest,
+    const struct qmi_elem_info *ei, const void *structure)
+{
+	struct qmi_state *s = state_of(qmi);
+	uint32_t node, port;
+	bool connected;
+	size_t size;
+	bool ziyi_hostcap=false;
+	uint32_t wlfw_node=0,wlfw_port=0;
+	void *buffer;
+	int length, error;
+
+	if (s == NULL || txn == NULL) {
+		return -EINVAL;
+	}
+	os_lock(&s->lock);
+	connected = s->connected;
+	node = s->peer_node;
+	port = s->peer_port;
+	wlfw_node=s->ziyi_wlfw_node;wlfw_port=s->ziyi_wlfw_port;
+	os_unlock(&s->lock);
+	if (sq != NULL) {
+		node = sq->sq_node;
+		port = sq->sq_port;
+	} else if (!connected) {
+		return -ENOTCONN;
+	}
+#ifdef KERNEL
+	ziyi_hostcap=msg_id==0x34 && node==13 && node==wlfw_node && port && port==wlfw_port;
+#else
+	(void)wlfw_node;(void)wlfw_port;
+#endif
+	if(ziyi_hostcap && (largest>65535u || txn->qmi!=qmi))return -EINVAL;
+	size=largest+QMI_HEADER_SIZE+(ziyi_hostcap?20u:0u);
+	buffer = os_alloc(size);
+	if (buffer == NULL) {
+		return -ENOMEM;
+	}
+	length = hakios_qmi_encode(QMI_REQUEST, (uint16_t)msg_id, txn->id, ei, structure, buffer, largest+QMI_HEADER_SIZE);
+	if (length < 0) {
+		os_free(buffer, size);
+		return length;
+	}
+#ifdef KERNEL
+	if(ziyi_hostcap){
+		length=ziyi_wlfw_host_cap(buffer,(size_t)length,size,25u,ziyi_wifi_native_binding(0));
+		if(length<0){os_free(buffer,size);return length;}
+		os_log("ZWIFI W13 HOST_CAP GPIO_INFO wlan=25 absent=ffff count=4 bytes=20\n");
+	}
+#endif
+	error = s->transport->send(s->port, node, port, buffer, (size_t)length);
+	os_free(buffer, size);
+	return error > 0 ? -error : error;
+}
+
+void
+qmi_txn_cancel(struct qmi_txn *txn)
+{
+	struct qmi_state *s = state_of(txn->qmi);
+	struct qmi_txn **found;
+
+	if (s == NULL) {
+		return;
+	}
+	os_lock(&s->lock);
+	found = find_transaction(s, txn, 0);
+	if (found != NULL) {
+		*found = txn->next;
+	}
+	os_unlock(&s->lock);
+}
+
+int
+hakios_qmi_txn_wait_ms(struct qmi_txn *txn, uint64_t milliseconds)
+{
+	struct qmi_state *s = state_of(txn->qmi);
+	uint64_t now = os_now_ms(), until = now + milliseconds;
+	struct qmi_txn **found;
+	int result;
+
+	if (s == NULL) {
+		return -EINVAL;
+	}
+	os_lock(&s->lock);
+	while (!txn->done && now < until) {
+		os_wait(&s->lock, txn, until - now);
+		now = os_now_ms();
+	}
+	found = find_transaction(s, txn, 0);
+	if (found != NULL) {
+		*found = txn->next;
+	}
+	result = txn->done ? txn->result : -ETIMEDOUT;
+	os_unlock(&s->lock);
+	return result;
+}
--- /dev/null
+++ b/bsd/dev/hakios.sta.c
@@ -0,0 +1,371 @@
+/*
+ * Darwin-on-hakios: what stands between the two sides of the station boundary
+ * (sys/hakios.sta.h).
+ *
+ * Whoever wants a network asks from wherever it happens to be: an ioctl of wifid's, the thread
+ * that brings the radio up. The station side wants to be called by one thread, one call at a
+ * time, and a scan or a join takes seconds. So what is asked for is noted here and done by a
+ * thread of this file's; the asker returns at once and hears the outcome as an event. One
+ * request of each kind can wait: a second scan asked for while the first has not begun
+ * replaces it, as does a second join.
+ *
+ * What the last scan heard is kept here, so that it can be read without entering the station
+ * side, and so is the list of channels.
+ *
+ * The network the kernel was given in a file is a standing request: joined at the start, and
+ * again whenever the radio is turned back on (Settings' switch), until somebody asks for
+ * another network -- as iOS itself rejoins the networks it knows. If that other network cannot
+ * be joined (a wrong passphrase), the standing one is joined again.
+ */
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <sys/errno.h>
+#include <sys/hakios.input.h>
+#include <sys/hakios.sta.h>
+#include <sys/systm.h>
+
+extern void thread_set_thread_name(thread_t thread, const char *name);
+
+#define HEARD_MOST      128
+#define CHANNELS_MOST   96
+
+static LCK_GRP_DECLARE(sta_lock_group, "hakios-sta");
+static LCK_MTX_DECLARE(sta_lock, &sta_lock_group);
+
+static const struct hakios_sta_ops *sta_ops;   /* the station side, while there is one */
+static bool sta_thread_made;
+static bool sta_calls;                          /* the thread is in a call of the station side's */
+static unsigned sta_reads;                      /* ... and so many others are in its state() */
+static bool sta_on;                             /* the radio's power, as last asked for */
+
+/* what has been asked for and not begun */
+static bool asked_power, asked_power_on, asked_scan, asked_join, asked_leave;
+static struct hakios_sta_scan asked_scan_what;
+static struct hakios_sta_join asked_join_what;
+static struct hakios_sta_join standing;        /* the network joined whenever the radio comes on (ssid_length 0: none) */
+static struct hakios_sta_join fallback;        /* ... as it was before a join that has not come through yet */
+
+static struct hakios_sta_bss *heard;           /* by the last scan that came to an end */
+static unsigned heard_count;
+static struct hakios_sta_channel channels[CHANNELS_MOST];
+static unsigned channel_count;
+
+static void
+heard_one(const struct hakios_sta_bss *bss, __unused void *context)
+{
+	/* (only the thread writes the list, and it reads the count without the lock) */
+	if (heard_count < HEARD_MOST) {
+		lck_mtx_lock(&sta_lock);
+		heard[heard_count++] = *bss;
+		lck_mtx_unlock(&sta_lock);
+	}
+}
+
+static void
+sta_runs(__unused void *parameter, __unused wait_result_t result)
+{
+	static struct hakios_sta_scan scan;
+	static struct hakios_sta_join join;
+
+	for (;;) {
+		const struct hakios_sta_ops *ops;
+		bool power = false, power_on = false, leave = false, do_join = false, do_scan = false;
+		int error = 0;
+
+		lck_mtx_lock(&sta_lock);
+		while (sta_ops == NULL || !(asked_power || asked_leave || asked_join || asked_scan)) {
+			lck_mtx_sleep(&sta_lock, LCK_SLEEP_DEFAULT, (event_t)&sta_ops, THREAD_UNINT);
+		}
+		ops = sta_ops;
+		/* one thing at a time, in the order that makes sense when several wait */
+		if (asked_power) {
+			power = true;
+			power_on = asked_power_on;
+			asked_power = false;
+		} else if (asked_leave) {
+			leave = true;
+			asked_leave = false;
+		} else if (asked_join) {
+			do_join = true;
+			join = asked_join_what;
+			bzero(&asked_join_what, sizeof(asked_join_what));
+			asked_join = false;
+		} else {
+			do_scan = true;
+			scan = asked_scan_what;
+			asked_scan = false;
+		}
+		sta_calls = true;
+		lck_mtx_unlock(&sta_lock);
+
+		if (power) {
+			struct hakios_sta_state *state = kalloc_data(sizeof(*state), Z_WAITOK | Z_ZERO);
+			bool was_joined = false;
+
+			if (state != NULL) {
+				ops->state(state);
+				was_joined = state->phase == HAKIOS_STA_JOINED;
+				kfree_data(state, sizeof(*state));
+			}
+			error = ops->power(power_on);
+			if (!power_on && was_joined) {
+				hakios_apple80211_event(HAKIOS_STA_LINK, 0);
+			}
+			hakios_apple80211_event(HAKIOS_STA_POWER, error == 0 ? power_on : !power_on);
+			lck_mtx_lock(&sta_lock);
+			if (error == 0 && power_on && standing.ssid_length != 0 && !asked_join) {
+				asked_join_what = standing;
+				asked_join = true;
+			}
+			lck_mtx_unlock(&sta_lock);
+		} else if (leave) {
+			ops->leave();
+			hakios_apple80211_event(HAKIOS_STA_LINK, 0);
+		} else if (do_join) {
+			error = ops->join(&join);
+			bzero(&join, sizeof(join));
+			hakios_apple80211_event(HAKIOS_STA_JOIN_DONE, error);
+			if (error == 0) {
+				hakios_apple80211_event(HAKIOS_STA_LINK, 1);
+			}
+			/* a join that did not come through (a wrong passphrase) leaves things as they were: the standing network again */
+			lck_mtx_lock(&sta_lock);
+			if (error != 0 && fallback.ssid_length != 0 && !asked_join && !asked_leave && !asked_power) {
+				standing = asked_join_what = fallback;
+				asked_join = true;
+			}
+			bzero(&fallback, sizeof(fallback));
+			lck_mtx_unlock(&sta_lock);
+		} else if (do_scan) {
+			error = ops->scan(&scan);
+			lck_mtx_lock(&sta_lock);
+			heard_count = 0;
+			lck_mtx_unlock(&sta_lock);
+			ops->heard(heard_one, NULL);
+			hakios_apple80211_event(HAKIOS_STA_SCAN_DONE, error);
+		}
+
+		lck_mtx_lock(&sta_lock);
+		sta_calls = false;
+		lck_mtx_unlock(&sta_lock);
+		thread_wakeup((event_t)&sta_calls);
+	}
+}
+
+/* ---- the station side ---------------------------------------------------------------------------------- */
+
+void
+hakios_sta_attach(const struct hakios_sta_ops *ops)
+{
+	thread_t thread;
+
+	if (ops == NULL) {
+		lck_mtx_lock(&sta_lock);
+		sta_ops = NULL;
+		asked_power = asked_scan = asked_join = asked_leave = false;
+		while (sta_calls || sta_reads != 0) {
+			lck_mtx_sleep(&sta_lock, LCK_SLEEP_DEFAULT, (event_t)&sta_calls, THREAD_UNINT);
+		}
+		heard_count = channel_count = 0;
+		lck_mtx_unlock(&sta_lock);
+		return;
+	}
+	if (heard == NULL) {
+		heard = kalloc_data(HEARD_MOST * sizeof(*heard), Z_WAITOK | Z_ZERO);
+	}
+	if (heard == NULL) {
+		hakios_wifi_tell("wifi: no memory for what a scan hears: nobody can ask the radio for a network\n");
+		return;
+	}
+	if (!sta_thread_made) {
+		if (kernel_thread_start(sta_runs, NULL, &thread) != KERN_SUCCESS) {
+			hakios_wifi_tell("wifi: no thread for the station: nobody can ask the radio for a network\n");
+			return;
+		}
+		thread_set_thread_name(thread, "wifi-station");
+		thread_deallocate(thread);
+		sta_thread_made = true;
+	}
+	channel_count = ops->channels(channels, CHANNELS_MOST);
+	lck_mtx_lock(&sta_lock);
+	sta_ops = ops;
+	sta_on = true;
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	hakios_apple80211_event(HAKIOS_STA_POWER, 1);
+}
+
+void
+hakios_sta_lost(int error)
+{
+	hakios_apple80211_event(HAKIOS_STA_LINK, error != 0 ? error : ECONNRESET);
+}
+
+/* ---- who wants a network ------------------------------------------------------------------------------- */
+
+bool
+hakios_sta_present(void)
+{
+	return sta_ops != NULL;
+}
+
+bool
+hakios_sta_powered(void)
+{
+	return sta_ops != NULL && sta_on;
+}
+
+bool
+hakios_sta_busy(void)
+{
+	bool busy;
+
+	lck_mtx_lock(&sta_lock);
+	busy = sta_ops != NULL && (sta_calls || asked_power || asked_leave || asked_join || asked_scan);
+	lck_mtx_unlock(&sta_lock);
+	return busy;
+}
+
+int
+hakios_sta_ask_power(bool on)
+{
+	lck_mtx_lock(&sta_lock);
+	if (sta_ops == NULL) {
+		lck_mtx_unlock(&sta_lock);
+		return ENXIO;
+	}
+	sta_on = on;
+	asked_power = true;
+	asked_power_on = on;
+	if (!on) {
+		asked_scan = asked_join = asked_leave = false;
+	}
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	return 0;
+}
+
+int
+hakios_sta_ask_scan(const struct hakios_sta_scan *what)
+{
+	lck_mtx_lock(&sta_lock);
+	if (sta_ops == NULL || !sta_on) {
+		lck_mtx_unlock(&sta_lock);
+		return sta_ops == NULL ? ENXIO : ENETDOWN;
+	}
+	asked_scan_what = *what;
+	asked_scan = true;
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	return 0;
+}
+
+int
+hakios_sta_ask_join_standing(const struct hakios_sta_join *what)
+{
+	int error = hakios_sta_ask_join(what);
+
+	lck_mtx_lock(&sta_lock);
+	if (error == 0) {
+		standing = *what;
+	}
+	lck_mtx_unlock(&sta_lock);
+	return error;
+}
+
+int
+hakios_sta_ask_join(const struct hakios_sta_join *what)
+{
+	lck_mtx_lock(&sta_lock);
+	if (sta_ops == NULL || !sta_on) {
+		lck_mtx_unlock(&sta_lock);
+		return sta_ops == NULL ? ENXIO : ENETDOWN;
+	}
+	if (standing.ssid_length != 0) {
+		fallback = standing;
+	}
+	bzero(&standing, sizeof(standing));     /* (whoever asks for a network now has the say) */
+	asked_join_what = *what;
+	asked_join = true;
+	asked_leave = false;
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	return 0;
+}
+
+int
+hakios_sta_ask_leave(void)
+{
+	lck_mtx_lock(&sta_lock);
+	if (sta_ops == NULL) {
+		lck_mtx_unlock(&sta_lock);
+		return ENXIO;
+	}
+	asked_leave = true;
+	asked_join = false;
+	bzero(&asked_join_what, sizeof(asked_join_what));
+	bzero(&fallback, sizeof(fallback));
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	return 0;
+}
+
+bool
+hakios_sta_heard(unsigned index, struct hakios_sta_bss *bss)
+{
+	bool there;
+
+	lck_mtx_lock(&sta_lock);
+	if ((there = index < heard_count)) {
+		*bss = heard[index];
+	}
+	lck_mtx_unlock(&sta_lock);
+	return there;
+}
+
+void
+hakios_sta_state(struct hakios_sta_state *state)
+{
+	const struct hakios_sta_ops *ops;
+
+	bzero(state, sizeof(*state));
+	lck_mtx_lock(&sta_lock);
+	if ((ops = sta_ops) != NULL) {
+		sta_reads++;
+	}
+	lck_mtx_unlock(&sta_lock);
+	if (ops != NULL) {
+		ops->state(state);
+		lck_mtx_lock(&sta_lock);
+		sta_reads--;
+		lck_mtx_unlock(&sta_lock);
+		thread_wakeup((event_t)&sta_calls);
+	}
+}
+
+unsigned
+hakios_sta_channels(struct hakios_sta_channel *out, unsigned most)
+{
+	unsigned count;
+
+	lck_mtx_lock(&sta_lock);
+	count = channel_count < most ? channel_count : most;
+	memcpy(out, channels, count * sizeof(*out));
+	lck_mtx_unlock(&sta_lock);
+	return count;
+}
+
+bool
+hakios_sta_address(uint8_t *address)
+{
+	const struct hakios_sta_ops *ops = sta_ops;
+
+	if (ops != NULL) {
+		memcpy(address, ops->address, 6);
+	}
+	return ops != NULL;
+}
