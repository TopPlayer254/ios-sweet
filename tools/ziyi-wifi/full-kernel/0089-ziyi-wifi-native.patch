+}
+int zwn_qmp_send_image(struct zwn_qmp*q,int on,const struct zwn_io*io){
+ if(!q||!io||q->poison||q->error||!q->open||q->send_pending||(on!=0&&on!=1))return 0;q->operation=ZWN_QMP_MESSAGE;
