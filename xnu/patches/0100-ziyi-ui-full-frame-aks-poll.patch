+ bool edge[SWEET_TOUCH_FINGERS];
+ UInt32 masks[SWEET_TOUCH_FINGERS];
+ int anchor=-1;
+ for(int i=0;i<SWEET_TOUCH_FINGERS;i++) {
+  bool d=(downMask&(1U<<i))!=0, was=fDown[i];
+  nx[i]=d?(IOFixed)(((int64_t)(fFitCanvas?xs[i]:xs[i]+fOffX)<<16)/(fFitCanvas?1080:fLogicalW)):fX[i];
+  ny[i]=d?(IOFixed)(((int64_t)(fFitCanvas?ys[i]:ys[i]+fOffY)<<16)/(fFitCanvas?2400:fLogicalH)):fY[i];
+  bool moved=d&&(nx[i]!=fX[i]||ny[i]!=fY[i]);
+  edge[i]=!was&&d?(xs[i]<SWEET_TOUCH_EDGE_PX||xs[i]>1079-SWEET_TOUCH_EDGE_PX||ys[i]<SWEET_TOUCH_EDGE_PX||ys[i]>2399-SWEET_TOUCH_EDGE_PX):fEdge[i];
+  masks[i]=edge[i]?kIOHIDDigitizerEventFromEdgeTip:0;
+  if(was!=d)masks[i]|=kIOHIDDigitizerEventTouch|kIOHIDDigitizerEventRange;
+  if(moved)masks[i]|=kIOHIDDigitizerEventPosition;
+  if(!was&&d)masks[i]|=kIOHIDDigitizerEventIdentity;
+  changed|=was!=d||moved;any|=d;
+  if(d&&anchor<0)anchor=i;
+ }
+ if(!changed){IOLockUnlock(fLock);return true;}
+ if(anchor<0)for(int i=0;i<SWEET_TOUCH_FINGERS;i++)if(fDown[i]){anchor=i;break;}
+ if(anchor<0){IOLockUnlock(fLock);return false;}
+ uint64_t now=mach_absolute_time();
+ IOHIDEvent *collection=IOHIDEvent::digitizerEvent(now,0,kIOHIDDigitizerTransducerTypeHand,false,0,0,0);
+ if(!collection){IOLockUnlock(fLock);return false;}
+ collection->setIntegerValue(kIOHIDEventFieldDigitizerCollection,TRUE);
+ UInt32 cmask=0,children=0;
+ for(int i=0;i<SWEET_TOUCH_FINGERS;i++) {
