+/* Atomic full TCM snapshot; caller passes ten native-normalized panel points.
+ * A failed event/child-array allocation commits no contact state. */
+bool
+SweetHIDTouch::touchFrame(const UInt32 *xs, const UInt32 *ys, UInt32 downMask)
+{
