+  if(!child){collection->release();IOLockUnlock(fLock);return false;}
+  child->setIntegerValue(kIOHIDEventFieldDigitizerIndex,i);
+  child->setIntegerValue(kIOHIDEventFieldDigitizerIdentity,i+2);
+  child->setIntegerValue(kIOHIDEventFieldDigitizerTouch,d);
+  child->setIntegerValue(kIOHIDEventFieldDigitizerEventMask,masks[i]);
+  collection->appendChild(child);child->release();
+  OSArray *array=collection->getChildren();
+  if(!array||array->getCount()!=++children){collection->release();IOLockUnlock(fLock);return false;}
+  cmask|=masks[i];
+ }
+ collection->setFixedValue(kIOHIDEventFieldDigitizerX,nx[anchor]);
+ collection->setFixedValue(kIOHIDEventFieldDigitizerY,ny[anchor]);
+ collection->setIntegerValue(kIOHIDEventFieldDigitizerRange,any);
+ collection->setIntegerValue(kIOHIDEventFieldDigitizerTouch,any);
+ collection->setIntegerValue(kIOHIDEventFieldDigitizerEventMask,cmask);
+ collection->setIntegerValue(kIOHIDEventFieldDigitizerButtonMask,any?1:0);
+ for(int i=0;i<SWEET_TOUCH_FINGERS;i++) {
+  fDown[i]=(downMask&(1U<<i))!=0;fEdge[i]=edge[i];
+  if(fDown[i]){fX[i]=nx[i];fY[i]=ny[i];}
+ }
+ IOLockUnlock(fLock);dispatchEvent(collection);collection->release();return true;
+}
