+/* RAM console tail. This code has no storage, display or reset dependencies.
+ * Raw snapshot layout is little endian. Reuse only with a qualified transport.
+ */
+#include <stdint.h>
+#include <stddef.h>
+
+#define ZLOG_SLOTS 256u
+#define ZLOG_PAYLOAD 240u
+#define ZLOG_MAX_APPEND 4096u
+
+static struct zlog_snapshot {
+    uint8_t magic[8];
+    uint32_t version, slots;
+    uint64_t last_reserved, dropped_bytes;
+    struct zlog_slot {
+        uint64_t sequence;
+        uint32_t length, crc;
+        uint8_t data[ZLOG_PAYLOAD];
+    } slot[ZLOG_SLOTS];
+} ziyi_bootlog = { .magic = {'Z','I','Y','I','L','O','G','1'}, .version = 1, .slots = ZLOG_SLOTS };
+
+_Static_assert(sizeof(struct zlog_slot) == 256, "bootlog slot ABI");
+_Static_assert(offsetof(struct zlog_snapshot, slot) == 32, "bootlog header ABI");
+
+static uint32_t zlog_crc_byte(uint32_t crc, uint8_t value)
+{
+    crc ^= value;
+    for (unsigned bit = 0; bit < 8; bit++) {
+        crc = (crc >> 1) ^ (0xedb88320u & (0u - (crc & 1u)));
+    }
+    return crc;
+}
+
+/* Interrupts and panic can reenter logging. Drop the contended batch instead
+ * of waiting on a writer that may be stopped or running on this same CPU. */
+static uint32_t zlog_busy;
+
+void sweet_log_append(const char *text, int bytes);
+size_t ziyi_bootlog_snapshot(void *output, size_t capacity);
+
+void sweet_log_append(const char *text, int bytes)
+{
+    if (!text || bytes <= 0) {
+        return;
+    }
+    uint32_t count = (uint32_t)bytes;
+    if (__atomic_exchange_n(&zlog_busy, 1, __ATOMIC_ACQUIRE)) {
+        __atomic_fetch_add(&ziyi_bootlog.dropped_bytes, count, __ATOMIC_RELAXED);
+        return;
+    }
+    if (count > ZLOG_MAX_APPEND) {
+        uint32_t skipped = count - ZLOG_MAX_APPEND;
+        __atomic_fetch_add(&ziyi_bootlog.dropped_bytes, skipped, __ATOMIC_RELAXED);
+        text += skipped;
+        count = ZLOG_MAX_APPEND;
+    }
+    while (count) {
+        uint32_t length = count > ZLOG_PAYLOAD ? ZLOG_PAYLOAD : count;
+        uint64_t sequence = __atomic_load_n(&ziyi_bootlog.last_reserved, __ATOMIC_RELAXED) + 1;
+        struct zlog_slot *slot = &ziyi_bootlog.slot[(sequence - 1) % ZLOG_SLOTS];
+        /* Invalidate the old commit before reusing this slot. The final
+         * sequence is published after length, bytes, and CRC. */
+        __atomic_exchange_n(&slot->sequence, 0, __ATOMIC_ACQ_REL);
+        __atomic_store_n(&ziyi_bootlog.last_reserved, sequence, __ATOMIC_RELEASE);
+        uint32_t crc = UINT32_MAX;
+        for (unsigned i = 0; i < 8; i++) {
+            crc = zlog_crc_byte(crc, (uint8_t)(sequence >> (8 * i)));
+        }
+        for (unsigned i = 0; i < 4; i++) {
+            crc = zlog_crc_byte(crc, (uint8_t)(length >> (8 * i)));
+        }
+        slot->length = length;
+        for (unsigned i = 0; i < length; i++) {
+            uint8_t value = (uint8_t)text[i];
+            slot->data[i] = value;
+            crc = zlog_crc_byte(crc, value);
+        }
+        slot->crc = ~crc;
+        __atomic_store_n(&slot->sequence, sequence, __ATOMIC_RELEASE);
+        text += length;
+        count -= length;
+    }
+    __atomic_store_n(&zlog_busy, 0, __ATOMIC_RELEASE);
+}
+
+/* For a live exporter running in thread context. Panic salvage operates on a
+ * quiesced RAM image and validates individual slots, independent of this lock. */
+size_t ziyi_bootlog_snapshot(void *output, size_t capacity)
+{
+    if (!output || capacity < sizeof(ziyi_bootlog) ||
+        __atomic_exchange_n(&zlog_busy, 1, __ATOMIC_ACQUIRE)) {
+        return 0;
+    }
+    uint8_t *dst = output;
+    const uint8_t *src = (const uint8_t *)&ziyi_bootlog;
+    for (size_t i = 0; i < sizeof(ziyi_bootlog); i++) {
+        /* The drop counter can change while any other caller holds the lock. */
+        if (i < 24 || i >= 32) {
+            dst[i] = src[i];
+        }
+    }
+    uint64_t dropped = __atomic_load_n(&ziyi_bootlog.dropped_bytes, __ATOMIC_RELAXED);
+    for (unsigned i = 0; i < 8; i++) {
+        dst[24 + i] = (uint8_t)(dropped >> (8 * i));
+    }
+    __atomic_store_n(&zlog_busy, 0, __ATOMIC_RELEASE);
+    return sizeof(ziyi_bootlog);
+}
+
+/* Linux persistent_ram console header. Append a bounded record to its
+ * non-wrapped prefix, preserving any previous console bytes and pmsg. */
+#define ZLOG_PSTORE_BYTES (2u << 20)
+#define ZLOG_DBGC 0x43474244u
+#define ZLOG_MARKER "\nZIYI-XNU-LOG1 "
+#define ZLOG_END "\nZIYI-XNU-END1\n"
+
+static uint32_t zlog_pstore_read(const volatile uint8_t *p)
+{
+    return (uint32_t)p[0] | (uint32_t)p[1]<<8 | (uint32_t)p[2]<<16 | (uint32_t)p[3]<<24;
+}
+
+static void zlog_hex(volatile uint8_t *out, uint64_t value, unsigned digits)
+{
+    static const char hex[] = "0123456789abcdef";
+    for (unsigned i = 0; i < digits; i++) {
+        out[i] = (uint8_t)hex[(value >> ((digits - 1 - i)*4)) & 15];
+    }
+}
+
+static int zlog_pstore_append(volatile uint8_t *console, size_t bytes, uint64_t nonce,
+                            const uint8_t *snapshot, size_t length, void (*order)(void))
+{
+    if (!console || ((uintptr_t)console & 3) || bytes != ZLOG_PSTORE_BYTES ||
+        !nonce || !snapshot || length != sizeof(ziyi_bootlog) || !order) {
+        return 0;
+    }
+    uint32_t signature = zlog_pstore_read(console);
+    uint32_t start = zlog_pstore_read(console+4), size = zlog_pstore_read(console+8);
+    if (start != size || (signature != ZLOG_DBGC && (signature || size))) {
+        return 0;
+    }
+    size_t wire = sizeof(ZLOG_MARKER)-1 + 16 + 1 + 8 + 1 + 8 + 1 + length*2 + sizeof(ZLOG_END)-1;
+    /* Leave one byte free. Linux interprets start==size as non-wrapped. */
+    if (size >= bytes-12 || wire >= bytes-12-size) {
+        return 0;
+    }
+    uint32_t crc = UINT32_MAX;
+    for (size_t i = 0; i < length; i++) {
+        crc = zlog_crc_byte(crc, snapshot[i]);
+    }
+    volatile uint8_t *out = console+12+size;
+    for (size_t i = 0; i < sizeof(ZLOG_MARKER)-1; i++) *out++ = ZLOG_MARKER[i];
+    zlog_hex(out, nonce, 16);
+    out += 16;
+    *out++ = ' ';
+    zlog_hex(out, length, 8);
+    out += 8;
+    *out++ = ' ';
+    zlog_hex(out, ~crc, 8);
+    out += 8;
+    *out++ = '\n';
+    for (size_t i = 0; i < length; i++) {
+        zlog_hex(out, snapshot[i], 2);
+        out += 2;
+    }
+    for (size_t i = 0; i < sizeof(ZLOG_END)-1; i++) *out++ = ZLOG_END[i];
+    order();
+    volatile uint32_t *header = (volatile uint32_t *)(uintptr_t)console;
+    header[2] = size+(uint32_t)wire;
+    header[1] = size+(uint32_t)wire;
+    header[0] = ZLOG_DBGC;
+    order();
+    return zlog_pstore_read(console) == ZLOG_DBGC &&
+           zlog_pstore_read(console+4) == size+wire && zlog_pstore_read(console+8) == size+wire;
+}
+
+/* Opt-in one-shot experiment before bsd_autoconf. The bootloader must supply
+ * the grant only after checking the live FDT and excluding other occupants. */
+#define ZLOG_RAMOOPS_PA 0xa7000000ull
+#define ZLOG_PSCI_FEATURES 0x8400000au
+#define ZLOG_PSCI_RESET2 0xc4000012u
+
+extern vm_offset_t io_map(vm_offset_t, vm_size_t, unsigned int, vm_prot_t, bool);
+void ziyi_log_probe(void);
+
+static uint8_t zlog_export[sizeof(ziyi_bootlog)];
+
+static void zlog_drain(void)
+{
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+static int32_t zlog_psci(uint32_t function, uint32_t arg)
+{
+    register uint64_t x0 __asm__("x0") = function;
+    register uint64_t x1 __asm__("x1") = arg;
+    register uint64_t x2 __asm__("x2") = 0;
+    register uint64_t x3 __asm__("x3") = 0;
+    __asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3)
+                     :: "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12",
+                        "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+    return (int32_t)x0;
+}
+
+__attribute__((noinline)) void ziyi_log_probe(void)
+{
+    uint64_t nonce = 0, grant = 0;
+    if (!PE_parse_boot_argn("ziyi_log_nonce", &nonce, sizeof(nonce)) || !nonce) {
+        return;
+    }
+    if (PE_parse_boot_argn("ziyi_log_window", &grant, sizeof(grant)) && grant == ZLOG_RAMOOPS_PA) {
+        int32_t features = zlog_psci(ZLOG_PSCI_FEATURES, ZLOG_PSCI_RESET2);
+        printf("ZIYI headless XNU BSD checkpoint, PSCI_RESET2 features=%d\n", features);
+        if (features >= 0) {
+            vm_offset_t map = io_map(ZLOG_RAMOOPS_PA, ZLOG_PSTORE_BYTES, VM_WIMG_WCOMB,
+                                     VM_PROT_READ | VM_PROT_WRITE, true);
+            if (map && ziyi_bootlog_snapshot(zlog_export, sizeof(zlog_export)) == sizeof(zlog_export) &&
+                zlog_pstore_append((volatile uint8_t *)(uintptr_t)map, ZLOG_PSTORE_BYTES, nonce,
+                                   zlog_export, sizeof(zlog_export), zlog_drain)) {
+                zlog_psci(ZLOG_PSCI_RESET2, 0);
+            }
+        }
+    }
+    /* An enabled experiment must park if its known warm-reset path returns. */
+    for (;;) {
+        (void)tsleep(&zlog_export, PZERO, "zlogpark", 0);
+    }
+}
+
