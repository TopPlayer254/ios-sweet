+__attribute__((noinline)) uint32_t g35_crc(const void *ptr,size_t n){
+ const uint8_t*p=ptr;uint32_t c=~0u;
+ for(size_t i=0;i<n;i++){c^=p[i];for(unsigned j=0;j<8;j++)c=(c>>1)^(0xedb88320u&(0u-(c&1)));}
+ return ~c;
