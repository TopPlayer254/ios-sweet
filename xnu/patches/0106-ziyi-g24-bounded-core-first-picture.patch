+  g24pix_valid_page(&r->ring,r->epoch)&&g24pix_valid_page(&r->target,r->epoch)&&g24pix_valid_page(&r->fence,r->epoch)&&
+  r->ring.iova!=r->target.iova&&r->ring.iova!=r->fence.iova&&r->target.iova!=r->fence.iova;
+}
