+static int g24pix_valid_page(const struct gp_page*p,uint32_t epoch){
+ return p->iova&&!(p->iova&(GP_PAGE-1))&&p->iova<=UINT32_MAX-GP_PAGE&&
+  p->bytes==GP_PAGE&&p->epoch==epoch&&p->private_owned==1;
+}
