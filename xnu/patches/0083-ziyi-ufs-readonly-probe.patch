+    for(unsigned i=0;i<32;i++) {
+        uint8_t expected=i==0?1:i==2?0xd0:i==3?u[3]:i==16?0x1b:i==20?0x30:0;
+        if(u[i]!=expected)return 0;
+    }
+    for(unsigned i=0;i<32;i++) {
+        uint8_t expected=i==0?0x21:i==2?0xd0:i==3?u[3]:0;
+        if(u[32+i]!=expected)return 0;
