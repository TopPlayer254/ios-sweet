+        if(((0x20u^(m&0x7fffu))&~((m>>16)&0x7fffu))!=0) continue;
+        /* Only the actually surveyed exact SID, index and context. */
+        if(i!=0||m!=0x80000020u||s->s2cr[i]!=0) return 0;
+        matches++;
