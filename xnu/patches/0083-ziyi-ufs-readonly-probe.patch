+ * controller maximum, not an inventory of allocated firmware descriptors.
+ * This profile is only inspected, NEVER replayed. Old data PRDT is unused. */
+static inline int u6_firmware_profile(const uint8_t *ring,const uint8_t *u,uint64_t base) {
+    if((base&1023)||!u3_firmware_span(base,4352)||
