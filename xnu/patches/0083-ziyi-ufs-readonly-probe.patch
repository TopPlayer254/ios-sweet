+static inline int u6_command(struct u1_cmd *out,unsigned op,unsigned lun,uint64_t lba,
+                              uint32_t count,uint32_t bs,uint64_t blocks) {
+    if(lun!=0xd0)return u1_command(out,op,lun,lba,count,bs,blocks);
