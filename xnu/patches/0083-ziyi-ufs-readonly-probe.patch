+    if(!u1.pa||u1.pa%PAGE_SIZE||u1.pa>UINT64_MAX-U1_DMA_BYTES) return;
+    for(unsigned off=0;off<U1_DMA_BYTES;off+=PAGE_SIZE)
+        if(ptoa_64(pmap_find_phys(kernel_pmap,(addr64_t)u1.dma+off))!=u1.pa+off) return;
