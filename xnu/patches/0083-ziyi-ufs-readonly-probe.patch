+     * PTM/FB override or unmeasured global attribute configuration. */
+    if((s->cr0!=0x280406u && s->cr0!=0x290406u)||s->cr2||
+       s->id0!=0x4c017e7du||s->id1!=0x6000004eu||s->id2!=0x5111u||s->id7!=0x24u) return 0;
