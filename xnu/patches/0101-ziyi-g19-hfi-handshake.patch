+ return 1;
+}
+static int ziyi_hfi_diagnostic_order(void *ctx,enum gh_live_order o){
+ struct g19_hfi_runtime *s=ctx;return s->ops->live.order(s->ops->live.ctx,o);
+}
+static int ziyi_hfi_diagnostic_bell(void *ctx){
